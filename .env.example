# PostgreSQL Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=shareyou_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Security Settings
SECRET_KEY=your_super_secret_jwt_key
EXPIRE_TIME=60
INVITE_EXPIRE_TIME=5

# AWS / MinIO S3 Settings
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION_NAME=us-east-1
AWS_SESSION_TOKEN=optional_session_token
S3_BUCKET_NAME=shareyou-bucket
S3_EXTERNAL_URL=http://localhost:9000

# MinIO Root User Settings (for local Docker MinIO)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Application Settings
DEBUG_MODE=True
LOG_LEVEL=INFO
MAX_PROJECT_SIZE_BYTES=52428800  # 50 MB